# EM-001 ci suite — fast, deterministic, stdlib-only (no network, no ML).
# Gate-relevant categories per plan §6.3: ageing, abstention, noise, update.
# All personas and places are synthetic (public-repo rule §0.1).
{"id":"ageing_identity_01","category":"ageing","memories":[{"content":"The user's name is Marta Kolar and she lives in Brackenridge","kind":"profile","age_days":120,"importance":0.9,"domain":"People","scope_user":""},{"content":"Marta's sister Tonia keeps bees near Aldermoor","kind":"fact","age_days":5,"importance":0.6,"domain":"People","scope_user":""}],"noise":{"generator":"filler","count":200,"seed":7},"turns":[{"query":"where does the user live?","expect_ids":["$0"],"expect_substrings":["Brackenridge"],"must_not":["$noise"]}]}
{"id":"ageing_tooling_01","category":"ageing","memories":[{"content":"The staging server runs Ubuntu 22.04 with nginx","kind":"fact","age_days":150,"importance":0.8,"domain":"Infrastructure","scope_user":""},{"content":"CI runners were refreshed last week on Ubuntu 24.04","kind":"fact","age_days":4,"importance":0.5,"domain":"Infrastructure","scope_user":""}],"noise":{"generator":"filler","count":200,"seed":8},"turns":[{"query":"what does the staging server run?","expect_ids":["$0"],"expect_substrings":["Ubuntu 22.04"],"must_not":["$noise"]}]}
{"id":"abstention_junk_01","category":"abstention","memories":[{"content":"The user's favorite tea is rooibos","kind":"profile","age_days":10,"importance":0.5,"domain":"Personal","scope_user":""}],"noise":{"generator":"filler","count":200,"seed":9},"turns":[{"query":"zzqx nonsense a","expect_ids":[],"expect_substrings":[],"must_not":["$noise"]}]}
{"id":"abstention_unrelated_01","category":"abstention","memories":[{"content":"The user bakes sourdough every Sunday","kind":"fact","age_days":12,"importance":0.5,"domain":"Leisure","scope_user":""}],"noise":{"generator":"filler","count":150,"seed":12},"turns":[{"query":"what is orbital decay of a geosynchronous satellite?","expect_ids":[],"expect_substrings":[],"must_not":["$noise"]}]}
{"id":"noise_ranking_01","category":"noise","memories":[{"content":"The client payment gateway charges a 2.9 percent fee per transaction","kind":"fact","age_days":3,"importance":0.8,"domain":"Finance","scope_user":""}],"noise":{"generator":"filler","count":300,"seed":10},"turns":[{"query":"what percentage fee does the payment gateway charge per transaction?","expect_ids":["$0"],"expect_substrings":["2.9"],"must_not":["$noise"]}]}
{"id":"update_port_01","category":"update","memories":[{"content":"The API gateway used to listen on port 8080 behind the load balancer during early bringup","kind":"fact","age_days":200,"importance":0.7,"domain":"Infrastructure","scope_user":""},{"content":"Since the migration the API gateway listens on port 9090 with TLS termination","kind":"fact","age_days":2,"importance":0.7,"domain":"Infrastructure","scope_user":""}],"noise":{"generator":"filler","count":120,"seed":11},"turns":[{"query":"which port does the API gateway listen on now?","expect_ids":["$1"],"expect_substrings":["9090"],"must_not":[]}]}
{"id":"update_preference_01","category":"update","memories":[{"content":"The user preferred red notification badges on the dashboard","kind":"preference","age_days":180,"importance":0.6,"domain":"Preferences","scope_user":""},{"content":"The user now prefers blue notification badges on the dashboard after the redesign","kind":"preference","age_days":1,"importance":0.6,"domain":"Preferences","scope_user":""}],"noise":{"generator":"filler","count":120,"seed":13},"turns":[{"query":"what color notification badges does the user prefer?","expect_ids":["$1"],"expect_substrings":["blue"],"must_not":[]}]}
