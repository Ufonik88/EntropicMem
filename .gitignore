# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/

# Build / distribution
dist/
build/
*.egg-info/
*.egg

# Databases / local state
*.db
*.sqlite
*.sqlite3

# ...except the committed migration fixtures (EM-203). They are tiny synthetic
# v2.x databases the migration tests need, and CI must not have to regenerate
# them from git history. The parent directory is not itself excluded, so this
# negation is effective.
!tests/fixtures/db/*.db

# Exports (generated)
export/
*.json
!benchmarks/probes.json
!export/graph.html
!evals/baselines/*.json

# Eval results are generated per run (baselines above are the committed ones).
# Ignore the directory's *contents*, not the directory itself: git cannot
# re-include a file whose parent directory is excluded, so `evals/results/`
# would make the perf-*.json negation below a silent no-op.
evals/results/*

# Perf bench results are generated artifacts (EM-005); allow them despite the
# blanket *.json privacy guard. Never contains user data — seeded corpus only.
!evals/results/perf-*.json
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment / secrets
.env
*.env.local
*.key
*.pem

# Logs
*.log
logs/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
.hypothesis/

# Skill packaging (runtime)
skills/entropicmem/__pycache__/

# Generated graph exports (regenerated by the graph refresh job)
graph_export/

# Desktop attachment staging (user-provided files)
.hermes/

# Worktrees and tool caches
.worktrees/
.ruff_cache/
